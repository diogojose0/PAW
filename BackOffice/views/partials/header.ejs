<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || 'PAW Marketplace' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/errorstyle.css">
  <link rel="stylesheet" href="/stylesheets/product-formstyle.css">
  <link rel="stylesheet" href="/stylesheets/headerstyle.css">
</head>

<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
  <div class="container">
    <a class="navbar-brand" href="/">PAW Marketplace</a>

    <div class="d-flex align-items-center gap-2">
      <% if (currentUser) { %>
        <span class="text-light small">
          <strong><%= currentUser.name %></strong> · <%= currentUser.role %>
        </span>

        <form action="/auth/logout" method="GET">
          <button class="btn btn-outline-light btn-sm" type="submit">Logout</button>
        </form>
      <% } else { %>
        <a class="btn btn-outline-light btn-sm" href="/auth/login">Login</a>
        <a class="btn btn-light btn-sm" href="/auth/register">Register</a>
      <% } %>
    </div>
  </div>
</nav>

<div class="container">
  <% if (flash && flash.text) { %>
    <div
      id="flashMessage"
      class="alert alert-<%= flash.type || 'info' %> alert-dismissible fade show"
      role="alert"
    >
      <%= flash.text %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>