<link rel="stylesheet" href="/stylesheets/dashboard-sidebar.css">

<div class="card shadow-sm sticky-top dashboard-sidebar">
  <div class="card-body p-3">
    <div class="small text-uppercase text-muted fw-semibold mb-3">
      <%= sidebarTitle || 'Navigation' %>
    </div>

    <div class="nav nav-pills flex-column gap-2">
      <% (sidebarLinks || []).forEach((link) => { %>
        <% if (link.disabled) { %>
          <span class="nav-link disabled d-flex justify-content-between align-items-center border rounded">
            <span><%= link.label %></span>
            <% if (link.badge !== undefined && link.badge !== null) { %>
              <span class="badge text-bg-secondary rounded-pill"><%= link.badge %></span>
            <% } %>
          </span>
        <% } else { %>
          <a
            href="<%= link.href %>"
            class="nav-link d-flex justify-content-between align-items-center border rounded"
          >
            <span><%= link.label %></span>
            <% if (link.badge !== undefined && link.badge !== null) { %>
              <span class="badge text-bg-secondary rounded-pill"><%= link.badge %></span>
            <% } %>
          </a>
        <% } %>
      <% }) %>
    </div>
  </div>
</div>