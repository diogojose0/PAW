<%- include('../partials/header', { title: title }) %>

<%- include('../error') %>

<h1 class="mb-4">Coupons</h1>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
  <div>
    <p class="text-muted mb-0">
      Manage discount coupons for your supermarket.
    </p>
  </div>

  <div class="d-flex gap-2">
    <a href="/supermarket/coupons/new" class="btn btn-success">New Coupon</a>
    <a href="/supermarket" class="btn btn-secondary">Back</a>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Type</th>
            <th>Value</th>
            <th>Minimum Order</th>
            <th>Validity</th>
            <th>Usage</th>
            <th>Status</th>
            <th style="width: 150px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!coupons || coupons.length === 0) { %>
            <tr>
              <td colspan="9" class="text-center">No coupons created yet.</td>
            </tr>
          <% } %>

          <% coupons.forEach((coupon) => { %>
            <tr>
              <td><strong><%= coupon.code %></strong></td>
              <td><%= coupon.name %></td>
              <td>
                <% if (coupon.discountType === 'percent') { %>
                  Percentage
                <% } else if (coupon.discountType === 'free_shipping') { %>
                  Free Shipping
                <% } else { %>
                  Fixed
                <% } %>
              </td>
              <td>
                <% if (coupon.discountType === 'percent') { %>
                  <%= Number(coupon.discountValue || 0).toFixed(2) %>%
                <% } else if (coupon.discountType === 'free_shipping') { %>
                  Courier shipping
                <% } else { %>
                  <%= Number(coupon.discountValue || 0).toFixed(2) %> €
                <% } %>
              </td>
              <td><%= Number(coupon.minOrderValue || 0).toFixed(2) %> €</td>
              <td>
                <div class="small">
                  <div>
                    From:
                    <%= coupon.validFrom ? new Date(coupon.validFrom).toLocaleDateString('pt-PT') : '-' %>
                  </div>
                  <div>
                    Until:
                    <%= coupon.validUntil ? new Date(coupon.validUntil).toLocaleDateString('pt-PT') : '-' %>
                  </div>
                </div>
              </td>
              <td>
                <% if (coupon.usageLimit === null || coupon.usageLimit === undefined) { %>
                  <%= coupon.usedCount || 0 %> / unlimited
                <% } else { %>
                  <%= coupon.usedCount || 0 %> / <%= coupon.usageLimit %>
                <% } %>
              </td>
              <td>
                <span class="badge <%= coupon.active ? 'text-bg-success' : 'text-bg-secondary' %>">
                  <%= coupon.active ? 'Active' : 'Inactive' %>
                </span>
              </td>
              <td>
                <form method="POST" action="/supermarket/coupons/<%= coupon._id %>/toggle-active">
                  <button
                    class="btn btn-sm <%= coupon.active ? 'btn-outline-danger' : 'btn-outline-success' %>"
                    type="submit">
                    <%= coupon.active ? 'Deactivate' : 'Activate' %>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>