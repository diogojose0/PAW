<%- include('../partials/header', { title: title }) %>

<%- include('../error') %>

<h1 class="mb-4"><%= product ? 'Edit Product' : 'New Product' %></h1>

<%
  const selectedCategoryId =
    product?.categoryId && typeof product.categoryId === 'object'
      ? String(product.categoryId._id)
      : (product?.categoryId ? String(product.categoryId) : '');
%>

<form method="POST" enctype="multipart/form-data" action="<%= product ? '/supermarket/products/' + product._id + '/edit' : '/supermarket/products/new' %>" class="row g-3">
  <div class="col-md-6">
    <label class="form-label">Name</label>
    <input class="form-control" name="name" value="<%= product?.name || '' %>" required>
  </div>

  <div class="col-md-6">
    <label class="form-label">Category</label>
    <select class="form-select" name="categoryId" required>
      <option value="">Choose a category</option>
      <% categories.forEach((cat) => { %>
        <option value="<%= cat._id %>" <%= selectedCategoryId === String(cat._id) ? 'selected' : '' %>>
          <%= cat.name %><%= cat.active === false ? ' (inactive)' : '' %>
        </option>
      <% }) %>
    </select>
  </div>

  <div class="col-md-6">
    <label class="form-label">Price</label>
    <input class="form-control" type="number" min="0" step="0.01" name="price" value="<%= product?.price ?? '' %>" required>
  </div>

  <div class="col-md-6">
    <label class="form-label">Stock</label>
    <input class="form-control" type="number" min="0" step="1" name="stock" value="<%= product?.stock ?? '' %>" required>
  </div>

  <div class="col-12">
    <label class="form-label">Product Image</label>
    <input class="form-control" type="file" name="image" accept=".jpg,.jpeg,.png,.webp">
  </div>

  <% if (product?.imageUrl) { %>
    <div class="col-12">
      <p class="mb-2"><strong>Current Image:</strong></p>
      <img
        src="<%= product.imageUrl %>"
        alt="Product image"
        class="shadow-sm product-image"
      >
    </div>
  <% } %>

  <div class="col-12">
    <label class="form-label">Description</label>
    <textarea class="form-control" name="description" rows="3"><%= product?.description || '' %></textarea>
  </div>

  <div class="col-12">
    <button class="btn btn-success" type="submit">Save</button>
    <a class="btn btn-secondary" href="/supermarket/products">Back</a>
  </div>
</form>

<%- include('../partials/footer') %>