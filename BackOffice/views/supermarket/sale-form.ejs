<%- include('../partials/header', { title: title }) %>

<%- include('../error') %>

<h1 class="mb-4">New Sale</h1>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <h4 class="mb-3">Customer</h4>

        <% if (customer) { %>
          <p><strong><%= customer.name %></strong></p>
          <p class="mb-1"><%= customer.email %></p>
          <p class="mb-3"><%= customer.phone %></p>

          <form method="POST" action="/supermarket/sales/customer/clear">
            <button class="btn btn-outline-danger btn-sm">Remove Customer</button>
          </form>
        <% } else if (sale.pendingCustomerEmail) { %>
          <div class="alert alert-info">
            Email not found. Fill in the remaining information to create the customer.
          </div>

          <form method="POST" action="/supermarket/sales/customer/create" class="row g-3">
            <div class="col-12">
              <label class="form-label">Email</label>
              <input
                class="form-control"
                type="email"
                name="email"
                value="<%= sale.pendingCustomerEmail %>"
                readonly>
            </div>

            <div class="col-12">
              <label class="form-label">Name</label>
              <input class="form-control" name="name" required>
            </div>

            <div class="col-12">
              <label class="form-label">Address</label>
              <input class="form-control" name="address" required>
            </div>

            <div class="col-12">
              <label class="form-label">Contact</label>
              <input class="form-control" name="phone" required>
            </div>

            <div class="col-12 d-flex gap-2">
              <button class="btn btn-primary w-100" type="submit">
                Create Customer
              </button>
            </div>
          </form>

          <form method="POST" action="/supermarket/sales/customer/clear" class="mt-2">
            <button class="btn btn-outline-secondary btn-sm">Cancel</button>
          </form>
        <% } else { %>
          <form method="POST" action="/supermarket/sales/customer/check-email" class="row g-3">
            <div class="col-12">
              <label class="form-label">Email</label>
              <input class="form-control" type="email" name="email" required>
            </div>

            <div class="col-12">
              <button class="btn btn-primary w-100" type="submit">
                Verify Email
              </button>
            </div>
          </form>
        <% } %>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-body">
        <h4 class="mb-3">Sale Summary</h4>

        <% if (!customer) { %>
          <div class="alert alert-warning mb-3">
            Associate a customer before finalize sale.
          </div>
        <% } %>

        <% if (!sale.items || sale.items.length === 0) { %>
          <p class="text-muted mb-3">No products added yet.</p>
        <% } else { %>
          <div class="table-responsive mb-3">
            <table class="table table-sm table-bordered align-middle">
              <thead>
                <tr>
                  <th>Product</th>
                  <th style="width: 190px;">Qty</th>
                  <th>Subtotal</th>
                  <th style="width: 120px;"></th>
                </tr>
              </thead>
              <tbody>
                <% sale.items.forEach((item) => { %>
                  <tr>
                    <td><%= item.nameSnapshot %></td>

                    <td>
                      <form method="POST" action="/supermarket/sales/cart/update" class="d-flex gap-2">
                        <input type="hidden" name="productId" value="<%= item.productId %>">
                        <input type="hidden" name="productSearch" value="<%= productSearch %>">
                        <input type="hidden" name="category" value="<%= selectedCategory %>">

                        <input
                          class="form-control form-control-sm"
                          type="number"
                          name="quantity"
                          value="<%= item.quantity %>"
                          min="1"
                          required>

                        <button class="btn btn-sm btn-outline-primary" type="submit">
                          Update
                        </button>
                      </form>
                    </td>

                    <td><%= Number(item.subtotal).toFixed(2) %> €</td>

                    <td>
                      <form method="POST" action="/supermarket/sales/cart/remove">
                        <input type="hidden" name="productId" value="<%= item.productId %>">
                        <input type="hidden" name="productSearch" value="<%= productSearch %>">
                        <input type="hidden" name="category" value="<%= selectedCategory %>">
                        <button class="btn btn-sm btn-danger" type="submit">Remove</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <div class="mb-3">
            <p class="mb-1">
              <strong>Items Total:</strong>
              <span
                id="itemsTotalValue"
                data-raw="<%= Number(sale.itemsTotal || 0).toFixed(2) %>"
              ><%= Number(sale.itemsTotal || 0).toFixed(2) %></span> €
            </p>

            <p class="mb-1">
              <strong>Coupon Discount:</strong>
              <span
                id="couponDiscountValue"
                data-discount="<%= Number(sale.discountAmount || 0).toFixed(2) %>"
                data-coupon-type="<%= sale.coupon?.discountType || '' %>"
              ><%= Number(sale.discountAmount || 0).toFixed(2) %></span> €
            </p>

            <p class="mb-1">
              <strong>Delivery Cost:</strong>
              <span id="deliveryCostValue">0.00</span> €
            </p>

            <p class="mb-0">
              <strong>Final Total:</strong>
              <span id="finalTotalValue"><%= Number(sale.discountedItemsTotal || sale.itemsTotal || 0).toFixed(2) %></span> €
            </p>
          </div>

          <div class="mb-3">
            <h5 class="mb-2">Coupon</h5>

            <% if (sale.coupon) { %>
              <div class="border rounded bg-light p-2 small mb-2">
                <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                  <div>
                    <div class="fw-semibold">
                      <%= sale.coupon.code %>
                      <% if (sale.coupon.name) { %>
                        - <%= sale.coupon.name %>
                      <% } %>
                    </div>

                    <div class="text-muted">
                      Discount:
                      <% if (sale.coupon.discountType === 'percent') { %>
                        <%= Number(sale.coupon.discountValue || 0).toFixed(2) %>%
                      <% } else if (sale.coupon.discountType === 'free_shipping') { %>
                        Free courier shipping
                      <% } else { %>
                        <%= Number(sale.coupon.discountValue || 0).toFixed(2) %> €
                      <% } %>
                    </div>

                    <% if (sale.coupon.discountType === 'free_shipping') { %>
                      <div class="text-muted">
                        Applies only to courier delivery
                      </div>
                    <% } %>

                    <% if (sale.coupon.validationError) { %>
                      <div class="text-danger">
                        <%= sale.coupon.validationError %>
                      </div>
                    <% } %>
                  </div>

                  <form method="POST" action="/supermarket/sales/coupon/clear" class="m-0">
                    <input type="hidden" name="productSearch" value="<%= productSearch %>">
                    <input type="hidden" name="category" value="<%= selectedCategory %>">
                    <button class="btn btn-sm btn-outline-danger" type="submit">
                      Remove
                    </button>
                  </form>
                </div>
              </div>
            <% } else { %>
              <form method="POST" action="/supermarket/sales/coupon/apply" class="row g-2">
                <input type="hidden" name="productSearch" value="<%= productSearch %>">
                <input type="hidden" name="category" value="<%= selectedCategory %>">

                <div class="col-8">
                  <input
                    class="form-control"
                    type="text"
                    name="code"
                    placeholder="Insert coupon code">
                </div>

                <div class="col-4">
                  <button class="btn btn-outline-primary w-100" type="submit">
                    Apply
                  </button>
                </div>
              </form>
            <% } %>
          </div>

          <form method="POST" action="/supermarket/sales/checkout" class="mt-3">
            <div class="mb-3">
              <label class="form-label">Delivery Method</label>

              <% if (supermarket.deliveryMethods && supermarket.deliveryMethods.length > 0) { %>
                <% supermarket.deliveryMethods.forEach((method, index) => { %>
                  <%
                    const deliveryCost =
                      method === "pickup"
                        ? Number(supermarket.deliveryCosts?.pickup || 0)
                        : Number(supermarket.deliveryCosts?.courier || 0);
                  %>

                  <div class="form-check">
                    <input
                      class="form-check-input delivery-method-radio"
                      type="radio"
                      name="deliveryMethod"
                      id="delivery_<%= method %>"
                      value="<%= method %>"
                      data-cost="<%= deliveryCost.toFixed(2) %>"
                      <%= index === 0 ? "checked" : "" %>
                      required>

                    <label class="form-check-label" for="delivery_<%= method %>">
                      <%= method === "pickup" ? "Pickup" : "Courier" %>
                      (<%= deliveryCost.toFixed(2) %> €)
                    </label>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="alert alert-warning mt-2">
                  This supermarket has no delivery methods configured.
                </div>
              <% } %>
            </div>

            <div class="d-flex gap-2">
              <button
                class="btn btn-success w-100"
                type="submit"
                <%= !supermarket.deliveryMethods || supermarket.deliveryMethods.length === 0 ? 'disabled' : '' %>>
                Finalize Sale
              </button>
            </div>
          </form>

          <form method="POST" action="/supermarket/sales/cart/clear" class="mt-2">
            <input type="hidden" name="productSearch" value="<%= productSearch %>">
            <input type="hidden" name="category" value="<%= selectedCategory %>">
            <button class="btn btn-outline-secondary btn-sm">Clear Sale</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <h4 class="mb-3">Search Products</h4>

        <form method="GET" action="/supermarket/sales/new" class="row g-3">
          <div class="col-md-5">
            <input
              class="form-control"
              type="text"
              name="productSearch"
              value="<%= productSearch %>"
              placeholder="Search by product name">
          </div>

          <div class="col-md-4">
            <select class="form-select" name="category">
              <option value="">All Categories</option>
              <% categories.forEach((cat) => { %>
                <option
                  value="<%= cat._id %>"
                  <%= selectedCategory === String(cat._id) ? 'selected' : '' %>
                >
                  <%= cat.name %><%= cat.active === false ? ' (inactive)' : '' %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="col-md-3">
            <button class="btn btn-success w-100" type="submit">Search</button>
          </div>
        </form>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-body">
        <h4 class="mb-3">Products</h4>

        <div class="table-responsive">
          <table class="table table-bordered align-middle">
            <thead>
              <tr>
                <th>Photo</th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (products.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center">No products found.</td>
                </tr>
              <% } %>

              <% products.forEach((product) => { %>
                <tr>
                  <td style="width: 110px;">
                    <% if (product.imageUrl) { %>
                      <img
                        src="<%= product.imageUrl %>"
                        alt="<%= product.name %>"
                        style="width: 72px; height: 72px; object-fit: cover; border-radius: 10px;"
                        class="shadow-sm"
                      >
                    <% } else { %>
                      <span class="badge bg-secondary">No photo</span>
                    <% } %>
                  </td>
                  <td><%= product.name %></td>
                  <td><%= product.categoryId?.name || 'No category' %></td>
                  <td><%= Number(product.price).toFixed(2) %> €</td>
                  <td><%= product.stock %></td>
                  <td>
                    <form method="POST" action="/supermarket/sales/cart/add" class="d-flex gap-2 align-items-center">
                      <input type="hidden" name="productId" value="<%= product._id %>">
                      <input type="hidden" name="productSearch" value="<%= productSearch %>">
                      <input type="hidden" name="category" value="<%= selectedCategory %>">

                      <input
                        class="form-control form-control-sm"
                        type="number"
                        name="quantity"
                        value="1"
                        min="1"
                        max="<%= product.stock %>"
                        style="width: 80px;">

                      <button
                        class="btn btn-sm btn-primary"
                        type="submit">
                        Add
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<a href="/supermarket" class="btn btn-secondary mt-3">Back</a>

<script src="/javascripts/finalPriceCount.js"></script>

<%- include('../partials/footer') %>