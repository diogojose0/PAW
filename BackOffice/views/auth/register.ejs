<%- include('../partials/header', { title: 'Register' }) %>

<%- include('../error') %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h3 mb-3">Register</h1>

        <form method="POST" action="/auth/register" class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Name</label>
            <input
              class="form-control"
              name="name"
              value="<%= formData?.name || '' %>"
              required
            >
          </div>

          <div class="col-md-6">
            <label class="form-label">Email</label>
            <input
              class="form-control"
              type="email"
              name="email"
              value="<%= formData?.email || '' %>"
              required
            >
          </div>

          <div class="col-md-6">
            <label class="form-label">Password</label>
            <input class="form-control" type="password" name="password" required>
          </div>

          <div class="col-md-6">
            <label class="form-label">Contact</label>
            <input
              class="form-control"
              name="phone"
              value="<%= formData?.phone || '' %>"
              required
            >
          </div>

          <div class="col-12">
            <label class="form-label">Address</label>
            <input
              class="form-control"
              name="address"
              value="<%= formData?.address || '' %>"
              required
            >
          </div>

          <div class="col-md-6">
            <label class="form-label">Account Type</label>
            <select class="form-select" name="role" id="roleSelect" required>
              <option value="courier" <%= (formData?.role || 'courier') === 'courier' ? 'selected' : '' %>>
                Courier
              </option>
              <option value="supermarket" <%= formData?.role === 'supermarket' ? 'selected' : '' %>>
                Supermarket
              </option>
            </select>
          </div>

          <div class="col-12" id="supermarketFields" style="display: none;">
            <div class="border rounded p-3 bg-light">
              <h2 class="h5">Additional supermarket information:</h2>

              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Name</label>
                  <input
                    class="form-control"
                    name="supermarketName"
                    value="<%= formData?.supermarketName || '' %>"
                  >
                </div>

                <div class="col-md-6">
                  <label class="form-label">Opening Hour</label>
                  <input
                    class="form-control"
                    name="supermarketOpeningHours"
                    placeholder="09:00-19:00"
                    value="<%= formData?.supermarketOpeningHours || '' %>"
                  >
                </div>

                <div class="col-12">
                  <label class="form-label">Description</label>
                  <textarea class="form-control" name="supermarketDescription" rows="2"><%= formData?.supermarketDescription || '' %></textarea>
                </div>

                <div class="col-12">
                  <label class="form-label">Location</label>
                  <input
                    class="form-control"
                    name="supermarketLocation"
                    value="<%= formData?.supermarketLocation || '' %>"
                  >
                </div>

                <div class="col-md-6">
                  <label class="form-label">Pickup Cost</label>
                  <input
                    class="form-control"
                    type="number"
                    name="deliveryCosts[pickup]"
                    min="0"
                    step="0.01"
                    value="0"
                    readonly
                  >
                </div>

                <div class="col-md-6">
                  <label class="form-label">Courier Cost</label>
                  <input
                    class="form-control"
                    type="number"
                    name="deliveryCosts[courier]"
                    min="0"
                    step="0.01"
                    value="<%= formData?.deliveryCosts?.courier ?? '' %>"
                  >
                </div>
              </div>
            </div>
          </div>

          <div class="col-12">
            <button class="btn btn-success" type="submit">Create account</button>
            <a class="btn btn-link" href="/auth/login">Back to Login</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/javascripts/register-script.js"></script>
<script src="/javascripts/error-script.js"></script>

<%- include('../partials/footer') %>