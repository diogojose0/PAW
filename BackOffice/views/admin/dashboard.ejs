<%- include('../partials/header', { title: title }) %>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
>

<%
  const safeStats = stats || {};
  const safeUsersByRole = usersByRole || {};
  const safeOrdersByStatus = ordersByStatus || {};
  const safeRecentOrders = Array.isArray(recentOrders) ? recentOrders : [];
  const safeSupermarketsMapData = Array.isArray(supermarketsMapData) ? supermarketsMapData : [];

  const totalUsers = Number(safeStats.usersCount || 0);

  const adminPct = totalUsers ? ((Number(safeUsersByRole.admin || 0) / totalUsers) * 100) : 0;
  const supermarketPct = totalUsers ? ((Number(safeUsersByRole.supermarket || 0) / totalUsers) * 100) : 0;
  const courierPct = totalUsers ? ((Number(safeUsersByRole.courier || 0) / totalUsers) * 100) : 0;
  const clientPct = totalUsers ? ((Number(safeUsersByRole.client || 0) / totalUsers) * 100) : 0;
%>

<div class="row g-4 align-items-start">
  <div class="col-lg-3">
    <%- include('../partials/dashboard-sidebar', {
      sidebarTitle: 'Admin Panel',
      sidebarLinks: [
        { label: 'Dashboard', href: '/admin' },
        { label: 'Pending Supermarkets', href: '/admin/supermarkets/pending', badge: safeStats.pendingSupermarketsCount || 0 },
        { label: 'Manage Users', href: '/admin/users' },
        { label: 'Monitor Orders', href: '/admin/orders' },
        { label: 'Manage Categories', href: '/admin/categories' }
      ]
    }) %>
  </div>

  <div class="col-lg-9">
    <h1 class="mb-4">Admin Dashboard</h1>

    <div class="row g-3">
      <div class="col-md-4">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5>Users</h5>
            <p class="display-6"><%= safeStats.usersCount || 0 %></p>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5>Supermarkets</h5>
            <p class="display-6"><%= safeStats.supermarketsCount || 0 %></p>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-sm border-warning">
          <div class="card-body">
            <h5>Pending</h5>
            <p class="display-6"><%= safeStats.pendingSupermarketsCount || 0 %></p>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5>Products</h5>
            <p class="display-6"><%= safeStats.productsCount || 0 %></p>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5>Orders</h5>
            <p class="display-6"><%= safeStats.ordersCount || 0 %></p>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5>Categories</h5>
            <p class="display-6 mb-1"><%= safeStats.categoriesCount || 0 %></p>
            <small class="text-muted">
              Active: <%= safeStats.activeCategoriesCount || 0 %>
            </small>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4 mt-1">
      <div class="col-lg-6">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h5 class="mb-3">Users by role</h5>

            <div class="mb-3">
              <div class="d-flex justify-content-between">
                <span>Admins</span>
                <strong><%= safeUsersByRole.admin || 0 %></strong>
              </div>
              <div class="progress mt-1">
                <div class="progress-bar js-width-bar" data-width="<%= adminPct %>"></div>
              </div>
            </div>

            <div class="mb-3">
              <div class="d-flex justify-content-between">
                <span>Supermarkets</span>
                <strong><%= safeUsersByRole.supermarket || 0 %></strong>
              </div>
              <div class="progress mt-1">
                <div class="progress-bar bg-success js-width-bar" data-width="<%= supermarketPct %>"></div>
              </div>
            </div>

            <div class="mb-3">
              <div class="d-flex justify-content-between">
                <span>Couriers</span>
                <strong><%= safeUsersByRole.courier || 0 %></strong>
              </div>
              <div class="progress mt-1">
                <div class="progress-bar bg-warning js-width-bar" data-width="<%= courierPct %>"></div>
              </div>
            </div>

            <div>
              <div class="d-flex justify-content-between">
                <span>Clients</span>
                <strong><%= safeUsersByRole.client || 0 %></strong>
              </div>
              <div class="progress mt-1">
                <div class="progress-bar bg-info js-width-bar" data-width="<%= clientPct %>"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h5 class="mb-3">Orders by status</h5>

            <div class="row g-2">
              <div class="col-6">
                <div class="border rounded p-3 h-100">
                  <div class="text-muted small">Pending</div>
                  <div class="fs-4 fw-bold"><%= safeOrdersByStatus.pending || 0 %></div>
                </div>
              </div>
              <div class="col-6">
                <div class="border rounded p-3 h-100">
                  <div class="text-muted small">Confirmed</div>
                  <div class="fs-4 fw-bold"><%= safeOrdersByStatus.confirmed || 0 %></div>
                </div>
              </div>
              <div class="col-6">
                <div class="border rounded p-3 h-100">
                  <div class="text-muted small">Preparing</div>
                  <div class="fs-4 fw-bold"><%= safeOrdersByStatus.preparing || 0 %></div>
                </div>
              </div>
              <div class="col-6">
                <div class="border rounded p-3 h-100">
                  <div class="text-muted small">Delivering</div>
                  <div class="fs-4 fw-bold"><%= safeOrdersByStatus.delivering || 0 %></div>
                </div>
              </div>
              <div class="col-6">
                <div class="border rounded p-3 h-100 bg-light">
                  <div class="text-muted small">Delivered</div>
                  <div class="fs-4 fw-bold text-success"><%= safeOrdersByStatus.delivered || 0 %></div>
                </div>
              </div>
              <div class="col-6">
                <div class="border rounded p-3 h-100 bg-light">
                  <div class="text-muted small">Cancelled</div>
                  <div class="fs-4 fw-bold text-danger"><%= safeOrdersByStatus.cancelled || 0 %></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4 mt-1">
      <div class="col-lg-6">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h5 class="mb-3">Users by role chart</h5>
            <div id="adminUsersRoleChart" style="height: 320px;"></div>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h5 class="mb-3">Orders by status chart</h5>
            <div id="adminOrdersStatusChart" style="height: 320px;"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="card shadow-sm mt-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
          <div>
            <h5 class="mb-1">Approved Supermarkets Map</h5>
            <div class="text-muted small">
              Supermarkets with saved coordinates: <strong><%= safeSupermarketsMapData.length %></strong>
            </div>
          </div>
        </div>

        <% if (safeSupermarketsMapData.length === 0) { %>
          <div class="alert alert-warning mb-0">
            There are no approved supermarkets with saved coordinates yet.
          </div>
        <% } else { %>
          <div
            id="adminSupermarketsMap"
            style="height: 420px; border-radius: 12px; overflow: hidden;"
          ></div>
        <% } %>
      </div>
    </div>

    <div class="card shadow-sm mt-4">
      <div class="card-body">
        <h5 class="mb-3">Recent orders</h5>

        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead>
              <tr>
                <th>Order</th>
                <th>Client</th>
                <th>Supermarket</th>
                <th>Status</th>
                <th>Total</th>
                <th>Created At</th>
              </tr>
            </thead>
            <tbody>
              <% if (safeRecentOrders.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center">No orders found.</td>
                </tr>
              <% } %>

              <% safeRecentOrders.forEach((order) => { %>
                <tr>
                  <td><%= order._id %></td>
                  <td><%= order.clientUserId && order.clientUserId.name ? order.clientUserId.name : '-' %></td>
                  <td><%= order.supermarketId && order.supermarketId.name ? order.supermarketId.name : '-' %></td>
                  <td>
                    <span class="badge text-bg-secondary"><%= order.status %></span>
                  </td>
                  <td><%= Number(order.finalTotal || 0).toFixed(2) %> €</td>
                  <td><%= order.createdAt ? new Date(order.createdAt).toLocaleString('pt-PT') : '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="adminSupermarketsMapData">
  <%- JSON.stringify(safeSupermarketsMapData) %>
</script>

<script type="application/json" id="adminUsersByRoleData">
  <%- JSON.stringify({
    admin: safeUsersByRole.admin || 0,
    supermarket: safeUsersByRole.supermarket || 0,
    courier: safeUsersByRole.courier || 0,
    client: safeUsersByRole.client || 0,
  }) %>
</script>

<script type="application/json" id="adminOrdersByStatusData">
  <%- JSON.stringify({
    pending: safeOrdersByStatus.pending || 0,
    confirmed: safeOrdersByStatus.confirmed || 0,
    preparing: safeOrdersByStatus.preparing || 0,
    delivering: safeOrdersByStatus.delivering || 0,
    delivered: safeOrdersByStatus.delivered || 0,
    cancelled: safeOrdersByStatus.cancelled || 0,
  }) %>
</script>

<script
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""
></script>
<script src="/javascripts/admin-supermarkets-map.js"></script>

<script src="https://www.gstatic.com/charts/loader.js"></script>
<script src="/javascripts/admin-google-charts.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".js-width-bar").forEach(function (bar) {
      const width = Number(bar.dataset.width || 0);
      bar.style.width = width + "%";
    });
  });
</script>

<%- include('../partials/footer') %>